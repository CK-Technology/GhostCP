# Managed by GhostCP - do not edit by hand
# WordPress virtual host for {{ site.domain }}
{% if site.is_wp_multisite %}# Multisite mode: {{ site.wp_multisite_type }}{% endif %}

server {
    listen 80;
    listen [::]:80;
    server_name {% for d in all_domains %}{{ d }} {% endfor %};

{% if ssl_configured and site.ssl_force %}
    location ^~ /.well-known/acme-challenge/ {
        root {{ site.document_root }};
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {% for d in all_domains %}{{ d }} {% endfor %};

    ssl_certificate     {{ site.ssl_cert_path }};
    ssl_certificate_key {{ site.ssl_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
{% if site.ssl_hsts %}
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
{% endif %}
{% endif %}

    root {{ site.document_root }};
    index index.php;

    access_log /var/log/nginx/{{ site.domain }}.access.log;
    error_log  /var/log/nginx/{{ site.domain }}.error.log;

    client_max_body_size 64M;

{% if site.is_wp_multisite and site.wp_multisite_type == "subdirectory" %}
    # WordPress multisite (subdirectory)
    if (!-e $request_filename) {
        rewrite /wp-admin$ $scheme://$host$uri/ permanent;
        rewrite ^(/[^/]+)?(/wp-.*) $2 last;
        rewrite ^(/[^/]+)?(/.*\.php) $2 last;
    }
{% endif %}

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:{{ site.php_fpm_socket }};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_read_timeout 300;
{% if site.fastcgi_cache_enabled %}
        fastcgi_cache GHOSTCP;
        fastcgi_cache_valid 200 60m;
        fastcgi_cache_bypass $skip_cache;
        fastcgi_no_cache $skip_cache;
{% endif %}
    }

    # Deny access to sensitive WordPress files
    location = /xmlrpc.php { deny all; }
    location ~* /(?:uploads|files)/.*\.php$ { deny all; }
    location ~ /\.(?!well-known).* { deny all; }
    location = /wp-config.php { deny all; }

    location ~* \.(?:jpg|jpeg|gif|png|webp|svg|ico|css|js|woff2?|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }

    location ^~ /.well-known/acme-challenge/ {
        root {{ site.document_root }};
        allow all;
    }

{% for inc in site.custom_includes %}
    include {{ inc }};
{% endfor %}
{% if site.custom_config %}
    {{ site.custom_config }}
{% endif %}
}

# Managed by GhostCP - do not edit by hand
# Reverse proxy virtual host for {{ site.domain }}

server {
    listen 80;
    listen [::]:80;
    server_name {% for d in all_domains %}{{ d }} {% endfor %};

{% if ssl_configured and site.ssl_force %}
    location ^~ /.well-known/acme-challenge/ {
        root {{ site.document_root }};
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {% for d in all_domains %}{{ d }} {% endfor %};

    ssl_certificate     {{ site.ssl_cert_path }};
    ssl_certificate_key {{ site.ssl_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
{% if site.ssl_hsts %}
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
{% endif %}
{% endif %}

    access_log /var/log/nginx/{{ site.domain }}.access.log;
    error_log  /var/log/nginx/{{ site.domain }}.error.log;

    location ^~ /.well-known/acme-challenge/ {
        root {{ site.document_root }};
        allow all;
    }

    location / {
        proxy_pass {{ site.proxy_pass }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
{% for key, value in site.proxy_headers %}
        proxy_set_header {{ key }} {{ value }};
{% endfor %}
        proxy_read_timeout 60s;
        proxy_connect_timeout 60s;
    }

{% if site.custom_config %}
    {{ site.custom_config }}
{% endif %}
}
